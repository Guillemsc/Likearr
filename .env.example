# Jellyfin API connection and user whose likes Likearr should process
LIKEARR_JELLYFIN_URL=http://jellyfin:8096
LIKEARR_JELLYFIN_API_KEY=replace-with-jellyfin-api-key
LIKEARR_JELLYFIN_USERNAME=your-jellyfin-username

# Paths as seen inside the container and as reported by Jellyfin
LIKEARR_MUSIC_ROOT=/music
LIKEARR_EXPLO_ROOT=/music/Explo
LIKEARR_JELLYFIN_MUSIC_ROOT=/media/Music

# Host directories mounted into the container
LIKEARR_MUSIC_HOST=/path/to/music
LIKEARR_STATE_HOST=./state
LIKEARR_STATE_ROOT=/state
TZ=Europe/Madrid
LIKEARR_RUN_TIME=01:00
